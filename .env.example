# Neon Postgres connection string (from the Vercel <-> Neon integration or Neon dashboard)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin superuser credentials
ADMIN_USERNAME="admin"
# base64-encoded bcrypt hash of the admin password.
# Generate with:  npm run hash-password -- "yourStrongPassword"
# Paste the printed value as-is (also works pasted directly into the Vercel dashboard).
ADMIN_PASSWORD_HASH="<paste base64 value from the command above>"

# Secret used to sign the admin session cookie (use a long random string, e.g. `openssl rand -base64 32`)
SESSION_SECRET="change-me-to-a-long-random-string"
